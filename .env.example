# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_db

# JWT Configuration
SECRET_KEY=change-this-to-a-very-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (for workflow automation)
# For Gmail: Use App Password, not regular password
# Enable 2FA first, then generate App Password at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_FROM=noreply@ecommerce.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Application Configuration
APP_NAME=E-commerce API
APP_VERSION=1.0.0
DEBUG=True

# Optional: For production
# DEBUG=False
# CORS_ORIGINS=["https://yourfrontend.com"]